  "cards": [
    {
      "dot": "emerald",
      "title": "分层依赖方向",
      "items": [
        "消费入口 → 引擎/适配 → 语言核心/框架，单向无环",
        "web-cli-base 位于最底层：零 @lgdl/* 依赖的公共框架",
        "lgdl-web-cli / lgdl-web-op-cli 只依赖 base（+ core 类型）"
      ]
    },
    {
      "dot": "violet",
      "title": "V2 体系变化",
      "items": [
        "6 包更名 lgdl-*（core/layout/render/router/cli/web → lgdl-*）",
        "新增 lgdl-web-cli（图内容操作）与 lgdl-web-op-cli（UI 操作）",
        "web-cli-base 收敛为纯机制：DomainApi<Op,Doc> 泛型化"
      ]
    },
    {
      "dot": "slate",
      "title": "跨层直连（完整依赖见 deps 表）",
      "items": [
        "lgdl-web 直连 lgdl-core / lgdl-layout / lgdl-render（浏览器内管线）",
        "lgdl-web-cli 另依赖 lgdl-core 类型契约",
        "lgdl-cli → lgdl-render（render 命令）亦见 deps 表"
      ]
    }
  ]
