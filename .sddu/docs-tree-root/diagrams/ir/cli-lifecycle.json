  "cards": [
    {
      "dot": "emerald",
      "title": "唯一组装点",
      "items": [
        "session.ts：delayMs=600 全局间隔 + 注册 2 业务工具（lgdl-web-cli / lgdl-web-op-cli）",
        "内建 3 自动注册：web-fetch / sleep（delayMs:0 免除前置间隔）/ web-cli-help（listed:false）",
        "deriveTools 顺序 = [业务×2, web-fetch, sleep, web-cli-help]（共 5 schema）"
      ]
    },
    {
      "dot": "rose",
      "title": "机制边界",
      "items": [
        "base 零 LGDL / 零 React import（NFR-001/008），无业务包时自足可用",
        "未注册工具名 → ok:false 显式 ✖ 报错（不等待、不落入任何执行器）",
        "executor 抛异常 → 转 ok:false 稳定文案，异常明细仅 error 字段（EC-012）"
      ]
    },
    {
      "dot": "slate",
      "title": "返回闭环",
      "items": [
        "ToolResult 按 toolCallId 回填 role:tool turn，驱动下一轮 chat（中性循环）",
        "onToolDone → changed → onApply(source) 写回编辑器；run-local source 同轮推进（R-009）",
        "任一工具 !ok → 结果全回填后 push 纠正 user turn 重试一次（失败聚合）"
      ]
    }
  ]
