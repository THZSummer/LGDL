        "note": "parseLgdl -> layoutDocument -> renderSvg 三步主链。"
      },
      {
        "id": "error-exit",
        "label": "错误出口",
        "focus": [
          "parse",
          "stderr"
        ],
        "note": "error-only 校验失败即终止，不静默降级。"
      }
    ]
  },
  "stages": [
    {
      "label": "源"
    },
    {
      "label": "解析"
    },
    {
      "label": "布局"
