      "from": "parse",
      "to": "layout",
      "label": "ParseResult",
      "variant": "emphasis"
    },
    {
      "id": "parse-stderr",
      "from": "parse",
      "to": "stderr",
      "label": "valid=false",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "layout-render",
      "from": "layout",
      "to": "render",
      "label": "LayoutResult",
      "variant": "emphasis",
      "labelAt": [
        626,
        220
      ]
    },
    {
      "id": "render-svg",
      "from": "render",
      "to": "svg-out",
      "label": "SVG 文本",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "left",
      "via": [
        [
          745,
          157
        ]
      ]
    },
    {
      "id": "render-ascii",
      "from": "render",
      "to": "ascii-out",
      "label": "ASCII 文本",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "编译主链（三步）",
      "items": [
        "parseLgdl -> layoutDocument -> renderSvg / renderAscii",
        "终端 / 浏览器 / 示例脚本共用同一套引擎",
        "触发：lgdl-cli render --file f -o out.svg"
      ]
    },
    {
      "dot": "rose",
      "title": "error-only 严格校验",
      "items": [
        "valid=false 时 render 命令拒绝出图，无警告级静默降级",
        "错误含可定位路径（如 nodes[3].id）",
        "契约：ParseResult {document, issues, valid}"
      ]
    },
    {
      "dot": "slate",
      "title": "输出与源映射",
      "items": [
        "契约：LayoutResult {nodes, edges, w, h}",
        "SVG 内嵌 data-lgdl-loc=\"nodes[i]\"（render/index.ts:411,427）",
        "PNG 不在管线内：外部脚本经 resvg 转换"
      ]
    }
  ]
}