  "cards": [
    {
      "dot": "emerald",
      "title": "依赖不变量（实测）",
      "items": [
        "web-cli-base 零 @lgdl/* 依赖（类似 Spring 的公共框架，DomainApi<Op,Doc> 泛型化）",
        "lgdl-core / lgdl-router 零兄弟包依赖",
        "单向无环：lgdl-core ← lgdl-web-cli ← cli/web 与 web-cli-base ← 适配包 ← cli/web"
      ]
    },
    {
      "dot": "cyan",
      "title": "部署通道",
      "items": [
        "@lgdl/lgdl-cli -> npm（bin: lgdl-cli，v0.5.0 已发布，@lgdl/cli 更名）",
        "@lgdl/lgdl-web -> GitHub Pages（deploy-pages.yml）",
        "全部包间依赖版本约束均为 ^0.5.0"
      ]
    },
    {
      "dot": "amber",
      "title": "关键调用链（代码证据）",
      "items": [
        "lgdl-web-cli 另直接依赖 lgdl-core 类型契约（本图未画，见 deps 表）",
        "web 三工具自新源组装：WEB_CLI_TOOL 自 lgdl-web-cli / WEB_OP_TOOL 自 op-cli / web-fetch 自 base",
        "lgdl-web-op-cli 的 OpHandlerRegistry 是包定义协议、web 注入 React 回调的执行面"
      ]
    }
  ]
