title: 订单系统类图
type: uml-class

nodes:
  - id: user
    label: User
    kind: entity
    members:
      - kind: attribute
        name: id
        type: int
        visibility: private
      - kind: attribute
        name: name
        type: string
        visibility: private
      - kind: method
        name: login
        type: void
        params: "()"
        visibility: public
      - kind: method
        name: logout
        type: void
        params: "()"
        visibility: public
  - id: order
    label: Order
    kind: entity
    members:
      - kind: attribute
        name: id
        type: int
        visibility: private
      - kind: attribute
        name: userId
        type: int
        visibility: private
      - kind: attribute
        name: amount
        type: float
        visibility: private
      - kind: method
        name: create
        type: void
        params: "()"
        visibility: public
      - kind: method
        name: pay
        type: void
        params: "()"
        visibility: public
      - kind: method
        name: cancel
        type: void
        params: "()"
        visibility: public
  - id: payment
    label: Payment
    kind: entity
    members:
      - kind: attribute
        name: orderId
        type: int
        visibility: private
      - kind: attribute
        name: method
        type: string
        visibility: private
      - kind: method
        name: process
        type: void
        params: "()"
        visibility: public
  - id: cart
    label: Cart
    kind: entity
    members:
      - kind: attribute
        name: items
        type: list
        visibility: private
      - kind: method
        name: addItem
        type: void
        params: "()"
        visibility: public
      - kind: method
        name: removeItem
        type: void
        params: "()"
        visibility: public
      - kind: method
        name: checkout
        type: void
        params: "()"
        visibility: public

edges:
  - from: user
    to: order
    label: 拥有 1..*
  - from: order
    to: payment
    label: 发起 1..1
  - from: user
    to: cart
    label: 关联 1..1

groups:
  - id: domain
    label: 领域层
    contains: [user, order, cart]
  - id: infra
    label: 基础设施
    contains: [payment]
