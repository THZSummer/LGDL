type: datastream

nodes:
  - id: app
    label: App客户端
  - id: sdk
    label: 日志采集SDK
  - id: kafka
    label: Kafka集群
  - id: flink
    label: Flink作业
  - id: clickhouse
    label: ClickHouse
  - id: dashboard
    label: 实时大屏
  - id: alert
    label: 告警服务
  - id: redis
    label: Redis缓存

edges:
  - from: app
    to: sdk
    label: 埋点日志
  - from: sdk
    to: kafka
    label: 原始日志
  - from: kafka
    to: flink
    label: 日志流
    attrs:
      processing: consume
      partition: 按业务类型
  - from: flink
    to: clickhouse
    label: 聚合指标
    attrs:
      processing: aggregate
      window: "1min滚动窗口"
  - from: flink
    to: redis
    label: 实时指标缓存
    attrs:
      processing: aggregate
      ttl: "5min"
  - from: flink
    to: alert
    label: 告警事件
    attrs:
      processing: filter
      rule: "错误率超过5%"
  - from: clickhouse
    to: dashboard
    label: 指标查询
  - from: redis
    to: dashboard
    label: 缓存指标
  - from: alert
    to: dashboard
    label: 告警推送

groups:
  - id: g-source
    label: 数据源层
    contains: [app, sdk]
  - id: g-transport
    label: 传输层
    contains: [kafka]
  - id: g-compute
    label: 计算层
    contains: [flink]
  - id: g-storage
    label: 存储层
    contains: [clickhouse, redis]
  - id: g-app
    label: 应用层
    contains: [dashboard, alert]
