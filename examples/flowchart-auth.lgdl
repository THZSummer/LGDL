type: flowchart

nodes:
  - id: start
    label: 开始
    kind: start
  - id: register
    label: 填写注册信息
  - id: d-email-exists
    label: 邮箱已注册？
    kind: decision
  - id: p-email-exists
    label: 提示邮箱已被占用
  - id: send-verify
    label: 发送验证邮件
  - id: input-code
    label: 输入邮箱验证码
  - id: d-code
    label: 验证码正确？
    kind: decision
  - id: p-code-retry
    label: 重新输入验证码
  - id: reg-success
    label: 注册成功
  - id: login
    label: 输入账号密码登录
  - id: d-pwd
    label: 密码正确？
    kind: decision
  - id: p-pwd-wrong
    label: 提示密码错误
  - id: d-forgot
    label: 忘记密码？
    kind: decision
  - id: send-reset
    label: 发送重置邮件
  - id: d-reset
    label: 密码重置成功？
    kind: decision
  - id: p-reset-fail
    label: 重置失败重新发送
  - id: login-new
    label: 使用新密码登录
  - id: session
    label: 会话管理
  - id: d-session
    label: 会话是否有效？
    kind: decision
  - id: p-session-expire
    label: 会话过期重新登录
  - id: end
    label: 结束
    kind: end

edges:
  - from: start
    to: register
    label: 开始注册
  - from: register
    to: d-email-exists
    label: 提交注册
  - from: d-email-exists
    to: p-email-exists
    label: 是：邮箱已注册
  - from: p-email-exists
    to: register
    label: 返回修改
  - from: d-email-exists
    to: send-verify
    label: 否：邮箱未注册
  - from: send-verify
    to: input-code
    label: 邮件发送成功
  - from: input-code
    to: d-code
    label: 提交验证码
  - from: d-code
    to: p-code-retry
    label: 否：验证码错误
  - from: p-code-retry
    to: input-code
    label: 重新输入
  - from: d-code
    to: reg-success
    label: 是：验证码正确
  - from: reg-success
    to: login
    label: 跳转登录
  - from: login
    to: d-pwd
    label: 提交登录
  - from: d-pwd
    to: session
    label: 是：密码正确
  - from: d-pwd
    to: p-pwd-wrong
    label: 否：密码错误
  - from: p-pwd-wrong
    to: d-forgot
    label: 提示后询问
  - from: d-forgot
    to: send-reset
    label: 是：忘记密码
  - from: d-forgot
    to: login
    label: 否：记得密码
  - from: send-reset
    to: d-reset
    label: 重置邮件已发送
  - from: d-reset
    to: p-reset-fail
    label: 否：重置失败
  - from: p-reset-fail
    to: send-reset
    label: 重新发送
  - from: d-reset
    to: login-new
    label: 是：重置成功
  - from: login-new
    to: session
    label: 新密码登录
  - from: session
    to: d-session
    label: 校验会话
  - from: d-session
    to: session
    label: 是：会话有效
  - from: d-session
    to: p-session-expire
    label: 否：会话过期
  - from: p-session-expire
    to: login
    label: 重新登录
  - from: session
    to: end
    label: 退出登录
