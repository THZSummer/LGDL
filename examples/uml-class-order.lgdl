type: uml-class

nodes:
  - id: order
    label: 订单
    kind: entity
    members:
      - kind: attribute
        name: id
        visibility: private
        type: Long
      - kind: attribute
        name: userId
        visibility: private
        type: Long
      - kind: attribute
        name: status
        visibility: private
        type: String
      - kind: attribute
        name: totalAmount
        visibility: private
        type: BigDecimal
      - kind: attribute
        name: createdAt
        visibility: private
        type: LocalDateTime
      - kind: method
        name: calculateTotal
        visibility: public
        type: BigDecimal
        params: ()
      - kind: method
        name: pay
        visibility: public
        type: void
        params: ()
      - kind: method
        name: cancel
        visibility: public
        type: boolean
        params: ()
  - id: order-item
    label: 订单项
    kind: entity
    members:
      - kind: attribute
        name: id
        visibility: private
        type: Long
      - kind: attribute
        name: productId
        visibility: private
        type: Long
      - kind: attribute
        name: productName
        visibility: private
        type: String
      - kind: attribute
        name: quantity
        visibility: private
        type: Integer
      - kind: attribute
        name: price
        visibility: private
        type: BigDecimal
      - kind: method
        name: getSubtotal
        visibility: public
        type: BigDecimal
        params: ()
  - id: user
    label: 用户
    kind: entity
    members:
      - kind: attribute
        name: id
        visibility: private
        type: Long
      - kind: attribute
        name: name
        visibility: private
        type: String
      - kind: attribute
        name: email
        visibility: private
        type: String
      - kind: attribute
        name: phone
        visibility: private
        type: String
      - kind: method
        name: getOrders
        visibility: public
        type: "List<Order>"
        params: ()
      - kind: method
        name: createOrder
        visibility: public
        type: Order
        params: ()
  - id: payment
    label: 支付记录
    kind: entity
    members:
      - kind: attribute
        name: id
        visibility: private
        type: Long
      - kind: attribute
        name: orderId
        visibility: private
        type: Long
      - kind: attribute
        name: amount
        visibility: private
        type: BigDecimal
      - kind: attribute
        name: payMethod
        visibility: private
        type: String
      - kind: attribute
        name: status
        visibility: private
        type: String
      - kind: attribute
        name: paidAt
        visibility: private
        type: LocalDateTime
      - kind: method
        name: refund
        visibility: public
        type: boolean
        params: ()
  - id: address
    label: 收货地址
    kind: entity
    members:
      - kind: attribute
        name: id
        visibility: private
        type: Long
      - kind: attribute
        name: userId
        visibility: private
        type: Long
      - kind: attribute
        name: receiver
        visibility: private
        type: String
      - kind: attribute
        name: phone
        visibility: private
        type: String
      - kind: attribute
        name: detail
        visibility: private
        type: String
      - kind: method
        name: getFullAddress
        visibility: public
        type: String
        params: ()

edges:
  - from: order
    to: order-item
    label: 组合（订单项）
    cardinalityFrom: "1"
    cardinalityTo: "1..*"
  - from: user
    to: order
    label: 关联（下单）
    cardinalityFrom: "1"
    cardinalityTo: "1..*"
  - from: order
    to: payment
    label: 关联（支付）
    cardinalityFrom: "1"
    cardinalityTo: "1"
  - from: user
    to: address
    label: 聚合（拥有地址）
    cardinalityFrom: "1"
    cardinalityTo: "1..*"
  - from: order
    to: address
    label: 关联（配送至）
    cardinalityFrom: "1..*"
    cardinalityTo: "1"
