title: 电商 ER 图
type: er

nodes:
  - id: user
    label: 用户
    kind: entity
    members:
      - kind: attribute
        name: id
      - kind: attribute
        name: name
      - kind: attribute
        name: email
  - id: order
    label: 订单
    kind: entity
    members:
      - kind: attribute
        name: id
      - kind: attribute
        name: userId
      - kind: attribute
        name: amount
  - id: product
    label: 商品
    kind: entity
    members:
      - kind: attribute
        name: id
      - kind: attribute
        name: name
      - kind: attribute
        name: price
  - id: order-item
    label: 订单项
    kind: entity
    members:
      - kind: attribute
        name: id
      - kind: attribute
        name: orderId
      - kind: attribute
        name: productId

edges:
  - from: user
    to: order
    label: 拥有
    cardinalityFrom: "1"
    cardinalityTo: "*"
  - from: order
    to: order-item
    label: 包含
    cardinalityFrom: "1"
    cardinalityTo: "*"
  - from: product
    to: order-item
    label: 关联
    cardinalityFrom: "1"
    cardinalityTo: "*"
