type: gantt

nodes:
  - id: req-review
    label: 需求评审
    attrs:
      start: 0
      duration: 7
  - id: ui-design
    label: UI设计
    attrs:
      start: 7
      duration: 10
  - id: backend-dev
    label: 后端开发
    attrs:
      start: 17
      duration: 30
  - id: frontend-dev
    label: 前端开发
    attrs:
      start: 17
      duration: 28
  - id: qa-test
    label: 联调测试
    attrs:
      start: 47
      duration: 15
  - id: gray-release
    label: 灰度发布
    attrs:
      start: 62
      duration: 10
  - id: ops-marketing
    label: 运营推广
    attrs:
      start: 72
      duration: 20

edges:
  - from: req-review
    to: ui-design
    label: 依赖
  - from: req-review
    to: backend-dev
    label: 依赖
  - from: ui-design
    to: frontend-dev
    label: 依赖
  - from: backend-dev
    to: qa-test
    label: 依赖
  - from: frontend-dev
    to: qa-test
    label: 依赖
  - from: qa-test
    to: gray-release
    label: 依赖
  - from: gray-release
    to: ops-marketing
    label: 依赖

groups:
  - id: req
    label: 需求
    contains: [req-review, ui-design]
  - id: dev
    label: 研发
    contains: [backend-dev, frontend-dev, qa-test]
  - id: ops
    label: 运营
    contains: [gray-release, ops-marketing]
