type: arch

nodes:
  - id: web-client
    label: Web客户端
  - id: app-client
    label: App客户端
  - id: api-gateway
    label: API网关
  - id: user-service
    label: 用户服务
  - id: product-service
    label: 商品服务
  - id: order-service
    label: 订单服务
  - id: inventory-service
    label: 库存服务
  - id: payment-service
    label: 支付服务
  - id: mysql-cluster
    label: MySQL集群
  - id: redis-cache
    label: Redis缓存
  - id: mq
    label: 消息队列

edges:
  - from: web-client
    to: api-gateway
    label: 调用
  - from: app-client
    to: api-gateway
    label: 调用
  - from: api-gateway
    to: user-service
    label: 路由转发
  - from: api-gateway
    to: product-service
    label: 路由转发
  - from: api-gateway
    to: order-service
    label: 路由转发
  - from: api-gateway
    to: inventory-service
    label: 路由转发
  - from: api-gateway
    to: payment-service
    label: 路由转发
  - from: order-service
    to: inventory-service
    label: 调用
  - from: order-service
    to: payment-service
    label: 调用
  - from: user-service
    to: mysql-cluster
    label: 读写
  - from: product-service
    to: mysql-cluster
    label: 读写
  - from: order-service
    to: mysql-cluster
    label: 读写
  - from: inventory-service
    to: mysql-cluster
    label: 读写
  - from: payment-service
    to: mysql-cluster
    label: 读写
  - from: user-service
    to: redis-cache
    label: 读写缓存
  - from: product-service
    to: redis-cache
    label: 读写缓存
  - from: order-service
    to: redis-cache
    label: 读写缓存
  - from: inventory-service
    to: redis-cache
    label: 读写缓存
  - from: payment-service
    to: redis-cache
    label: 读写缓存
  - from: order-service
    to: mq
    label: 异步事件
  - from: inventory-service
    to: mq
    label: 异步事件
  - from: payment-service
    to: mq
    label: 异步事件

groups:
  - id: g-client
    label: 客户端层
    contains: [web-client, app-client]
  - id: g-gateway
    label: 网关层
    contains: [api-gateway]
  - id: g-service
    label: 业务服务层
    contains: [user-service, product-service, order-service, inventory-service, payment-service]
  - id: g-data
    label: 数据层
    contains: [mysql-cluster, redis-cache, mq]
